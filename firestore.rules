rules_version = '2';

// ============================================================
// FantasyChama — Phase 13: Complete Collection Coverage
// Changes from Phase 12:
//   - Added wallet_requests (Pochi deposit queue) rules
//   - Added side_bets (member-to-member wagers) rules
//   - Notifications: members can now create targeted notifications
//     (needed for side bet challenger → opponent notifications)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny — anything not explicitly matched is blocked
    match /{document=**} {
      allow read, write: if false;
    }

    // Returns the parent league document data
    function leagueData(leagueId) {
      let docRef = /databases/$(database)/documents/leagues/$(leagueId);
      return exists(docRef) ? get(docRef).data : {};
    }

    function isChairman(leagueId) {
      return request.auth != null &&
             leagueData(leagueId).get('chairmanId', '') == request.auth.uid;
    }

    function isCoAdmin(leagueId) {
      return request.auth != null &&
             (leagueData(leagueId).get('coAdminId', '') == request.auth.uid ||
              leagueData(leagueId).get('coAdminMapping', '') == request.auth.uid);
    }

    function isAdmin(leagueId) {
      return isChairman(leagueId) || isCoAdmin(leagueId);
    }

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Protects financial fields from being written by non-admins
    function touchesFinancialFields() {
      let sensitive = ['walletBalance', 'role', 'trustScore', 'hasPaid'];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitive);
    }

    // ──────────────────────────────────────────────────────────────
    // LEAGUES
    // ──────────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      // Allow reading league metadata so members can look up invite codes and verify rules
      allow read: if true;

      // Allow creating and updating league configuration (name, stakes, rules)
      allow create: if true;
      allow update: if true;
      allow delete: if isChairman(leagueId);

      // ── Memberships ───────────────────────────────────────────
      match /memberships/{memberId} {
        // Authenticated read only — phone numbers are PII; no public exposure
        allow read: if isAuthenticated();

        allow create: if isAdmin(leagueId);

        allow update: if
          isAdmin(leagueId)
          ||
          (
            // Member updating their own non-financial profile fields
            isAuthenticated() &&
            (
              resource.data.get('authUid', '') == request.auth.uid ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasAcceptedRules'])
            ) &&
            !touchesFinancialFields()
          )
          ||
          (
            // Member setting their own authUid on first login
            isAuthenticated() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid']) &&
            request.resource.data.authUid == request.auth.uid
          );

        allow delete: if isChairman(leagueId);
      }

      // ── Notifications ─────────────────────────────────────────
      match /notifications/{notifId} {
        allow read: if isAuthenticated();
        // Members can create targeted notifications (e.g. side bet challenges to opponent)
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (
          isAdmin(leagueId)
          ||
          (
            // Members can only mark notifications as read (append to readBy array)
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
            request.resource.data.readBy.hasAll(resource.data.readBy)
          )
        );
        allow delete: if isAdmin(leagueId);
      }

      // ── League Events (Ledger feed) ───────────────────────────
      match /league_events/{eventId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin(leagueId);
      }

      // ── Disputes ──────────────────────────────────────────────
      match /disputes/{disputeId} {
        allow read: if isAuthenticated() && (
          isAdmin(leagueId) ||
          resource.data.memberId == request.auth.uid
        );
        allow create: if isAuthenticated() &&
          request.resource.data.memberId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.keys().hasAll(['memberId', 'memberName', 'receiptCode', 'amount', 'status']);
        allow update: if isAdmin(leagueId);
        allow delete: if isChairman(leagueId);
      }

      // ── Pending Payouts ───────────────────────────────────────
      match /pending_payouts/{payoutId} {
        // All authenticated members can read (needed for winner confirmation)
        allow read: if isAuthenticated();
        allow create: if isChairman(leagueId);
        allow update: if isAdmin(leagueId);
        allow delete: if isChairman(leagueId);
      }

      // ── Winner Confirmations ──────────────────────────────────
      match /winner_confirmations/{confId} {
        allow read: if isAuthenticated() && (
          isAdmin(leagueId) ||
          resource.data.winnerId == request.auth.uid
        );
        allow create: if isAdmin(leagueId);
        allow update: if isAuthenticated() && (
          isAdmin(leagueId)
          ||
          (
            resource.data.winnerId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            request.resource.data.status == 'confirmed'
          )
        );
        allow delete: if isAdmin(leagueId);
      }

      // ── Transactions (Immutable Ledger) ───────────────────────
      match /transactions/{txId} {
        // Admins see all; members can read any transaction in their league
        allow read: if isAuthenticated();
        allow create: if isAdmin(leagueId);
        allow update, delete: if false; // Transactions are immutable — never modifiable
      }

      // ── M-Pesa STK Requests ───────────────────────────────────
      match /mpesa_requests/{requestId} {
        allow read: if isAdmin(leagueId);
        allow create: if isAuthenticated();
        // Only admin can update (e.g. backend marks as completed via Admin SDK)
        allow update: if isAdmin(leagueId);
        allow delete: if false;
      }

      // ── Pochi Deposit / Wallet Requests ──────────────────────
      // Members submit Pochi payment acknowledgments here.
      // The Chairman reviews and approves or rejects each one.
      match /wallet_requests/{requestId} {
        // Admin sees all; member sees only their own submissions
        allow read: if isAuthenticated() && (
          isAdmin(leagueId) ||
          resource.data.memberId == request.auth.uid
        );
        // Any authenticated member can create a Pochi acknowledgment
        allow create: if isAuthenticated() &&
          request.resource.data.memberId == request.auth.uid &&
          request.resource.data.keys().hasAll(['memberId', 'memberName', 'amount', 'status']);
        // Chairman/Co-Chair can approve or reject (update status field)
        allow update: if isAdmin(leagueId);
        allow delete: if false; // Immutable audit trail
      }

      // ── Side Bets ─────────────────────────────────────────────
      // Custom peer-to-peer wagers between league members.
      // Create: any authenticated member can create a side bet challenge.
      // Update: opponent can sign, members can endorse, admin can approve/reject/resolve.
      match /side_bets/{betId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.keys().hasAll(['title', 'status', 'challenger', 'opponent']) &&
          request.resource.data.status in ['pending_opponent', 'pending', 'open'];
        allow update: if isAuthenticated();
        allow delete: if isAdmin(leagueId);
      }

      // ── Wallet Top-up Requests ────────────────────────────────
      match /wallet_topup_requests/{requestId} {
        allow read: if isAuthenticated() && (
          isAdmin(leagueId) ||
          resource.data.memberId == request.auth.uid
        );
        allow create: if isAuthenticated() &&
          request.resource.data.keys().hasAll(['memberId', 'amount', 'status']) &&
          request.resource.data.status == 'pending';
        allow update: if isAdmin(leagueId);
        allow delete: if false; // Immutable audit trail
      }

      // ── HQ Settlements ────────────────────────────────────────
      match /hq_settlements/{settlementId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin(leagueId);
        allow delete: if false;
      }

      // ── B2C Payout Requests ───────────────────────────────────
      match /b2c_requests/{requestId} {
        allow read: if isAuthenticated() && (
          isAdmin(leagueId) ||
          resource.data.memberId == request.auth.uid
        );
        allow create, update: if isAdmin(leagueId);
        allow delete: if false;
      }

    } // end /leagues/{leagueId}

    // ──────────────────────────────────────────────────────────────
    // GLOBAL PLATFORM COLLECTIONS
    // ──────────────────────────────────────────────────────────────
    match /userLeagues/{phone} {
      allow read, write: if true;
    }

    match /platform_treasury/{docId} {
      allow read, write: if true;
    }

    match /platform_settings/{docId} {
      allow read, write: if true;
    }

  } // end /databases/{database}/documents
}
